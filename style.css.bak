/* ===================================================================
   NGÀY PHỤ NỮ VIỆT NAM 20-10 - LUXURY 3D INTERACTIVE CELEBRATION
   High-End Romantic Aesthetics & Dynamic Motion Design System
   =================================================================== */

:root {
  /* Default Theme: Hoàng Hôn Tình Yêu (Sunset Romance) */
  --bg-gradient: radial-gradient(circle at 50% 40%, #2e081d 0%, #17030f 50%, #080005 100%);
  --primary-rose: #ff2d75;
  --primary-rose-glow: rgba(255, 45, 117, 0.5);
  --secondary-pink: #ff758c;
  --accent-gold: #f6d365;
  --accent-gold-dark: #fda085;
  --accent-gold-glow: rgba(246, 211, 101, 0.4);
  --text-main: #fff5f8;
  --text-muted: #e6b8c8;
  --glass-bg: rgba(255, 255, 255, 0.08);
  --glass-border: rgba(255, 255, 255, 0.18);
  --glass-shadow: 0 16px 40px rgba(0, 0, 0, 0.45);
  --card-bg: linear-gradient(135deg, rgba(35, 10, 25, 0.92) 0%, rgba(18, 4, 13, 0.96) 100%);
  --card-border: rgba(255, 182, 193, 0.35);
  --light-color: #ffe6ee;
}

/* Theme: Đêm Tinh Tú Huyền Diệu (Midnight Galaxy) */
body.theme-midnight {
  --bg-gradient: radial-gradient(circle at 50% 40%, #1e0938 0%, #0c0217 50%, #030008 100%);
  --primary-rose: #d946ef;
  --primary-rose-glow: rgba(217, 70, 239, 0.5);
  --secondary-pink: #a855f7;
  --accent-gold: #38bdf8;
  --accent-gold-dark: #6366f1;
  --accent-gold-glow: rgba(56, 189, 248, 0.4);
  --text-main: #f5f3ff;
  --text-muted: #c4b5fd;
  --glass-bg: rgba(255, 255, 255, 0.06);
  --glass-border: rgba(217, 70, 239, 0.25);
  --card-bg: linear-gradient(135deg, rgba(25, 10, 45, 0.93) 0%, rgba(10, 3, 20, 0.97) 100%);
  --card-border: rgba(217, 70, 239, 0.4);
  --light-color: #e9d5ff;
}

/* Theme: Vườn Hoa Cổ Tích (Fairy Blossom) */
body.theme-fairy {
  --bg-gradient: radial-gradient(circle at 50% 40%, #3a0d24 0%, #1f0413 50%, #0d0107 100%);
  --primary-rose: #fb7185;
  --primary-rose-glow: rgba(251, 113, 133, 0.5);
  --secondary-pink: #f472b6;
  --accent-gold: #fde047;
  --accent-gold-dark: #f59e0b;
  --accent-gold-glow: rgba(253, 224, 71, 0.4);
  --text-main: #fff1f2;
  --text-muted: #fbcfe8;
  --glass-bg: rgba(255, 255, 255, 0.09);
  --glass-border: rgba(251, 113, 133, 0.3);
  --card-bg: linear-gradient(135deg, rgba(45, 12, 28, 0.92) 0%, rgba(20, 5, 12, 0.96) 100%);
  --card-border: rgba(251, 113, 133, 0.4);
  --light-color: #ffe4e6;
}

/* ================= Global Reset & Typography ================= */
* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

html, body {
  width: 100%;
  height: 100%;
  overflow: hidden;
  font-family: 'Be Vietnam Pro', sans-serif;
  color: var(--text-main);
  background: var(--bg-gradient);
  user-select: none;
  -webkit-tap-highlight-color: transparent;
}

/* ================= Preloader Screen ================= */
.preloader {
  position: fixed;
  inset: 0;
  z-index: 99999;
  background: #0d0108;
  display: flex;
  justify-content: center;
  align-items: center;
  transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.8s;
}

.preloader.fade-out {
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
}

.loader-content {
  text-align: center;
  max-width: 320px;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* Blooming Flower Loader */
.blooming-flower-loader {
  position: relative;
  width: 90px;
  height: 90px;
  margin-bottom: 24px;
  animation: flowerSpin 12s linear infinite;
}

.petal {
  position: absolute;
  width: 40px;
  height: 60px;
  background: linear-gradient(to top, #ff2d75, #ff9a8b);
  border-radius: 50% 50% 50% 50% / 60% 60% 40% 40%;
  top: 50%;
  left: 50%;
  transform-origin: center bottom;
  opacity: 0.85;
  filter: drop-shadow(0 0 10px rgba(255, 45, 117, 0.6));
}

.petal-1 { transform: translate(-50%, -100%) rotate(0deg); }
.petal-2 { transform: translate(-50%, -100%) rotate(72deg); }
.petal-3 { transform: translate(-50%, -100%) rotate(144deg); }
.petal-4 { transform: translate(-50%, -100%) rotate(216deg); }
.petal-5 { transform: translate(-50%, -100%) rotate(288deg); }

.loader-core {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 26px;
  height: 26px;
  border-radius: 50%;
  background: radial-gradient(circle, #ffe600, #ff7b00);
  box-shadow: 0 0 20px #ffe600;
  z-index: 10;
  animation: pulseCore 1.6s ease-in-out infinite alternate;
}

@keyframes flowerSpin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

@keyframes pulseCore {
  0% { transform: translate(-50%, -50%) scale(0.9); }
  100% { transform: translate(-50%, -50%) scale(1.15); box-shadow: 0 0 28px #ffd000; }
}

.loader-title {
  font-family: 'Playfair Display', serif;
  font-size: 2.4rem;
  letter-spacing: 4px;
  background: linear-gradient(135deg, #fff, #ffb8d2, #ffd079);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  margin-bottom: 8px;
}

.loader-subtitle {
  font-size: 0.95rem;
  color: var(--text-muted);
  font-weight: 300;
  margin-bottom: 20px;
}

.loader-bar-bg {
  width: 240px;
  height: 6px;
  background: rgba(255, 255, 255, 0.12);
  border-radius: 99px;
  overflow: hidden;
}

.loader-bar-fill {
  width: 15%;
  height: 100%;
  background: linear-gradient(90deg, #ff2d75, #f6d365);
  border-radius: 99px;
  transition: width 0.3s ease;
  box-shadow: 0 0 12px #ff2d75;
}

/* ================= 3D Canvas & Ambient Layers ================= */
#canvas-container {
  position: fixed;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
}

#webgl-canvas {
  width: 100% !important;
  height: 100% !important;
  display: block;
}

#cursorFxCanvas {
  position: fixed;
  inset: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 3;
}

.stardust-overlay {
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: 2;
  background: radial-gradient(circle at 50% 30%, transparent 60%, rgba(5, 0, 4, 0.4) 100%);
}

/* ================= Glassmorphic Buttons & Badges ================= */
.glass-btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 9px 18px;
  border-radius: 999px;
  background: var(--glass-bg);
  border: 1px solid var(--glass-border);
  color: var(--text-main);
  font-family: inherit;
  font-size: 0.9rem;
  font-weight: 500;
  cursor: pointer;
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);
}

.glass-btn:hover {
  background: rgba(255, 255, 255, 0.18);
  border-color: rgba(255, 255, 255, 0.35);
  transform: translateY(-2px);
  box-shadow: 0 8px 24px var(--primary-rose-glow);
}

.glass-btn:active {
  transform: translateY(0);
}

.glass-btn.btn-primary {
  background: linear-gradient(135deg, var(--primary-rose), #e11d48);
  border-color: rgba(255, 255, 255, 0.3);
  box-shadow: 0 6px 20px var(--primary-rose-glow);
  font-weight: 600;
}

.glass-btn.btn-primary:hover {
  background: linear-gradient(135deg, #ff4785, #f43f5e);
  box-shadow: 0 10px 28px rgba(255, 45, 117, 0.65);
}

.glass-btn.highlight-btn {
  border-color: var(--accent-gold);
  color: var(--accent-gold);
}

.glass-btn.highlight-btn:hover {
  background: rgba(246, 211, 101, 0.15);
  box-shadow: 0 8px 24px var(--accent-gold-glow);
}

/* ================= App Header ================= */
.app-header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 72px;
  padding: 0 28px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  z-index: 100;
  background: linear-gradient(to bottom, rgba(10, 2, 7, 0.75) 0%, rgba(10, 2, 7, 0) 100%);
  backdrop-filter: blur(6px);
  -webkit-backdrop-filter: blur(6px);
}

.logo-area {
  display: flex;
  align-items: center;
  gap: 14px;
}

.logo-badge {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48px;
  height: 48px;
  border-radius: 14px;
  background: linear-gradient(135deg, var(--primary-rose), var(--accent-gold));
  color: #fff;
  font-weight: 700;
  box-shadow: 0 4px 18px var(--primary-rose-glow);
  border: 1px solid rgba(255, 255, 255, 0.3);
}

.badge-num {
  font-size: 0.95rem;
  line-height: 1;
}

.badge-slash {
  font-size: 0.8rem;
  opacity: 0.8;
  margin: 0 1px;
}

.logo-text {
  display: flex;
  flex-direction: column;
}

.logo-title {
  font-family: 'Playfair Display', serif;
  font-size: 1.25rem;
  font-weight: 700;
  letter-spacing: 0.5px;
  background: linear-gradient(135deg, #ffffff, #ffe0ec);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.logo-tagline {
  font-size: 0.76rem;
  color: var(--text-muted);
  letter-spacing: 1px;
  text-transform: uppercase;
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 12px;
}

/* Theme Dropdown */
.theme-selector-dropdown {
  position: relative;
}

.theme-menu {
  position: absolute;
  top: calc(100% + 10px);
  right: 0;
  width: 220px;
  background: rgba(22, 6, 17, 0.94);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid var(--glass-border);
  border-radius: 16px;
  padding: 8px;
  box-shadow: var(--glass-shadow);
  display: none;
  flex-direction: column;
  gap: 4px;
  z-index: 200;
  animation: slideDownFade 0.25s cubic-bezier(0.16, 1, 0.3, 1);
}

.theme-menu.show {
  display: flex;
}

@keyframes slideDownFade {
  0% { opacity: 0; transform: translateY(-8px); }
  100% { opacity: 1; transform: translateY(0); }
}

.theme-option {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 14px;
  border-radius: 10px;
  cursor: pointer;
  font-size: 0.85rem;
  color: var(--text-muted);
  transition: all 0.2s;
}

.theme-option:hover, .theme-option.active {
  background: rgba(255, 255, 255, 0.12);
  color: #fff;
}

.color-dot {
  width: 14px;
  height: 14px;
  border-radius: 50%;
  border: 1px solid rgba(255, 255, 255, 0.4);
}

.sunset-dot { background: linear-gradient(135deg, #ff2d75, #f6d365); }
.midnight-dot { background: linear-gradient(135deg, #d946ef, #38bdf8); }
.fairy-dot { background: linear-gradient(135deg, #fb7185, #fde047); }

/* Music Bars Animation */
.music-bars {
  display: flex;
  align-items: flex-end;
  gap: 3px;
  height: 15px;
}

.music-bars .bar {
  width: 3px;
  background: var(--primary-rose);
  border-radius: 2px;
  height: 4px;
  transition: height 0.2s;
}

.music-playing .bar-1 { animation: soundBar 0.8s ease-in-out infinite alternate; }
.music-playing .bar-2 { animation: soundBar 1.1s ease-in-out infinite alternate 0.2s; }
.music-playing .bar-3 { animation: soundBar 0.9s ease-in-out infinite alternate 0.4s; }
.music-playing .bar-4 { animation: soundBar 1.2s ease-in-out infinite alternate 0.1s; }

@keyframes soundBar {
  0% { height: 3px; }
  100% { height: 15px; background: var(--accent-gold); }
}

/* ================= 3D Scene Controls HUD ================= */
.scene-controls-hud {
  position: fixed;
  left: 28px;
  bottom: 28px;
  z-index: 50;
  display: flex;
  flex-direction: column;
  gap: 8px;
  background: rgba(18, 4, 14, 0.65);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid var(--glass-border);
  padding: 12px 14px;
  border-radius: 20px;
  box-shadow: 0 12px 30px rgba(0, 0, 0, 0.35);
}

.hud-tooltip {
  font-size: 0.72rem;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 0.8px;
  font-weight: 600;
}

.scene-mode-buttons {
  display: flex;
  gap: 8px;
}

.mode-btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 8px 14px;
  border-radius: 12px;
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.12);
  color: var(--text-muted);
  font-family: inherit;
  font-size: 0.82rem;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.25s ease;
}

.mode-btn:hover {
  background: rgba(255, 255, 255, 0.14);
  color: #fff;
}

.mode-btn.active {
  background: linear-gradient(135deg, var(--primary-rose), var(--secondary-pink));
  color: #fff;
  border-color: rgba(255, 255, 255, 0.3);
  box-shadow: 0 4px 14px var(--primary-rose-glow);
}

.hud-hint {
  font-size: 0.72rem;
  color: var(--text-muted);
  opacity: 0.8;
  display: flex;
  align-items: center;
  gap: 6px;
  margin-top: 2px;
}

/* ================= Unopened Gift Callout Banner ================= */
.gift-callout {
  position: fixed;
  bottom: 100px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 40;
  display: flex;
  align-items: center;
  gap: 18px;
  padding: 14px 24px;
  background: rgba(26, 7, 20, 0.82);
  border: 1px solid rgba(255, 215, 0, 0.4);
  border-radius: 999px;
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  box-shadow: 0 12px 35px rgba(0, 0, 0, 0.5), 0 0 25px rgba(255, 45, 117, 0.3);
  transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
}

.gift-callout.hidden {
  opacity: 0;
  transform: translate(-50%, 30px);
  pointer-events: none;
}

.pulse-animation {
  animation: floatCallout 3s ease-in-out infinite;
}

@keyframes floatCallout {
  0%, 100% { transform: translate(-50%, 0); }
  50% { transform: translate(-50%, -8px); }
}

.callout-badge {
  width: 42px;
  height: 42px;
  border-radius: 50%;
  background: linear-gradient(135deg, #ffd700, #ff8c00);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.2rem;
  color: #4a0210;
  box-shadow: 0 0 18px rgba(255, 215, 0, 0.6);
}

.callout-content h3 {
  font-family: 'Playfair Display', serif;
  font-size: 1.05rem;
  margin-bottom: 2px;
  color: #fff;
}

.callout-content p {
  font-size: 0.82rem;
  color: var(--text-muted);
}

.callout-content strong {
  color: var(--accent-gold);
}

.pulse-glow-btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 10px 22px;
  border-radius: 999px;
  background: linear-gradient(135deg, var(--primary-rose), #e11d48);
  border: 1px solid rgba(255, 255, 255, 0.4);
  color: #fff;
  font-weight: 600;
  font-size: 0.9rem;
  cursor: pointer;
  box-shadow: 0 0 20px var(--primary-rose-glow);
  transition: all 0.3s;
}

.pulse-glow-btn:hover {
  transform: scale(1.06);
  box-shadow: 0 0 30px rgba(255, 45, 117, 0.85);
}

/* ================= 3D Luxury Celebratory Card Overlay ================= */
.greeting-overlay {
  position: fixed;
  inset: 0;
  z-index: 80;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 20px;
  transition: opacity 0.5s ease, visibility 0.5s;
}

.greeting-overlay.hidden {
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
}

.card-backdrop {
  position: absolute;
  inset: 0;
  background: rgba(8, 1, 6, 0.65);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
}

.card-3d-wrapper {
  position: relative;
  z-index: 2;
  perspective: 1200px;
  max-width: 620px;
  width: 100%;
  animation: cardEntrance 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

@keyframes cardEntrance {
  0% {
    opacity: 0;
    transform: translateY(60px) rotateX(15deg) scale(0.92);
  }
  100% {
    opacity: 1;
    transform: translateY(0) rotateX(0deg) scale(1);
  }
}

.luxury-card {
  position: relative;
  background: var(--card-bg);
  border: 1px solid var(--card-border);
  border-radius: 28px;
  padding: 44px 38px 36px;
  box-shadow: var(--glass-shadow), 0 0 50px rgba(255, 45, 117, 0.25), inset 0 0 30px rgba(255, 255, 255, 0.04);
  backdrop-filter: blur(30px);
  -webkit-backdrop-filter: blur(30px);
  overflow: hidden;
  transition: transform 0.2s cubic-bezier(0.2, 0, 0.2, 1);
}

/* Corner Ornaments */
.corner-ornament {
  position: absolute;
  width: 32px;
  height: 32px;
  border-color: var(--accent-gold);
  border-style: solid;
  opacity: 0.6;
  pointer-events: none;
}

.corner-ornament.top-left {
  top: 16px;
  left: 16px;
  border-width: 2px 0 0 2px;
  border-top-left-radius: 12px;
}

.corner-ornament.top-right {
  top: 16px;
  right: 16px;
  border-width: 2px 2px 0 0;
  border-top-right-radius: 12px;
}

.corner-ornament.bottom-left {
  bottom: 16px;
  left: 16px;
  border-width: 0 0 2px 2px;
  border-bottom-left-radius: 12px;
}

.corner-ornament.bottom-right {
  bottom: 16px;
  right: 16px;
  border-width: 0 2px 2px 0;
  border-bottom-right-radius: 12px;
}

.card-close-btn {
  position: absolute;
  top: 18px;
  right: 18px;
  width: 38px;
  height: 38px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(255, 255, 255, 0.2);
  color: var(--text-muted);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.1rem;
  cursor: pointer;
  z-index: 10;
  transition: all 0.25s;
}

.card-close-btn:hover {
  background: rgba(255, 45, 117, 0.4);
  color: #fff;
  transform: rotate(90deg);
}

.card-header-ornament {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 18px;
}

.ribbon-center {
  padding: 6px 20px;
  background: linear-gradient(90deg, #ff2d75, #f6d365);
  border-radius: 99px;
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 2px;
  color: #2b0314;
  box-shadow: 0 4px 14px rgba(255, 45, 117, 0.4);
}

.card-badge-circle {
  width: 54px;
  height: 54px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 215, 0, 0.25) 0%, rgba(255, 45, 117, 0.1) 100%);
  border: 1px solid var(--accent-gold);
  color: var(--accent-gold);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.4rem;
  margin: 0 auto 16px;
  box-shadow: 0 0 25px var(--accent-gold-glow);
  animation: floatCrown 3s ease-in-out infinite;
}

@keyframes floatCrown {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-5px); }
}

.card-headline {
  font-family: 'Playfair Display', serif;
  font-size: 1.95rem;
  text-align: center;
  font-weight: 700;
  line-height: 1.25;
  background: linear-gradient(135deg, #ffffff 10%, #ffd0e0 50%, #fed876 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  margin-bottom: 20px;
}

.recipient-display {
  text-align: center;
  margin-bottom: 20px;
}

.to-label {
  font-size: 0.85rem;
  color: var(--text-muted);
  font-style: italic;
  margin-right: 6px;
}

.to-name {
  font-family: 'Dancing Script', cursive;
  font-size: 1.6rem;
  color: var(--accent-gold);
  font-weight: 700;
}

.message-quote-box {
  position: relative;
  background: rgba(0, 0, 0, 0.25);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 18px;
  padding: 24px 26px;
  margin-bottom: 22px;
}

.quote-icon {
  position: absolute;
  font-size: 1.1rem;
  color: var(--accent-gold);
  opacity: 0.35;
}

.quote-open {
  top: 14px;
  left: 14px;
}

.quote-close {
  bottom: 14px;
  right: 14px;
}

.card-message {
  font-size: 1.02rem;
  line-height: 1.7;
  color: var(--text-main);
  text-align: center;
  font-style: italic;
  font-weight: 300;
  min-height: 80px;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: opacity 0.3s ease;
}

.sender-signature {
  text-align: right;
  margin-bottom: 26px;
  padding-right: 10px;
}

.sig-label {
  display: block;
  font-size: 0.78rem;
  color: var(--text-muted);
  font-style: italic;
}

.sig-name {
  font-family: 'Great Vibes', cursive;
  font-size: 1.65rem;
  color: #ffb8d2;
}

/* Card Action Buttons */
.card-footer-buttons {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  justify-content: center;
}

.pill-btn {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  padding: 10px 18px;
  border-radius: 999px;
  font-family: inherit;
  font-size: 0.85rem;
  font-weight: 600;
  cursor: pointer;
  border: none;
  transition: all 0.25s ease;
}

.pill-btn.secondary-btn {
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(255, 255, 255, 0.16);
  color: var(--text-main);
}

.pill-btn.secondary-btn:hover {
  background: rgba(255, 255, 255, 0.18);
  border-color: rgba(255, 255, 255, 0.3);
  transform: translateY(-2px);
}

.pill-btn.primary-gradient-btn {
  background: linear-gradient(135deg, var(--primary-rose), #e11d48);
  color: #fff;
  box-shadow: 0 4px 16px var(--primary-rose-glow);
}

.pill-btn.primary-gradient-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 22px rgba(255, 45, 117, 0.6);
}

.pill-btn.gold-gradient-btn {
  background: linear-gradient(135deg, #f6d365, #fda085);
  color: #3d0715;
  box-shadow: 0 4px 16px var(--accent-gold-glow);
}

.pill-btn.gold-gradient-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 22px rgba(246, 211, 101, 0.6);
}

/* ================= Bottom Wishes Category Carousel ================= */
.wishes-pill-carousel {
  position: fixed;
  bottom: 22px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 50;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  max-width: 90vw;
}

.carousel-title {
  font-size: 0.74rem;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 0.8px;
  background: rgba(10, 2, 8, 0.5);
  padding: 4px 12px;
  border-radius: 99px;
  backdrop-filter: blur(8px);
}

.pill-tags {
  display: flex;
  gap: 8px;
  overflow-x: auto;
  padding: 4px;
  scrollbar-width: none;
  -ms-overflow-style: none;
  max-width: 100%;
}

.pill-tags::-webkit-scrollbar {
  display: none;
}

.wish-pill {
  white-space: nowrap;
  background: rgba(20, 5, 16, 0.72);
  border: 1px solid var(--glass-border);
  color: var(--text-muted);
  font-family: inherit;
  font-size: 0.82rem;
  font-weight: 500;
  padding: 8px 16px;
  border-radius: 999px;
  cursor: pointer;
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  transition: all 0.25s ease;
}

.wish-pill:hover {
  background: rgba(255, 255, 255, 0.15);
  color: #fff;
  border-color: rgba(255, 255, 255, 0.3);
}

.wish-pill.active {
  background: linear-gradient(135deg, var(--primary-rose), #e11d48);
  color: #fff;
  border-color: rgba(255, 255, 255, 0.4);
  box-shadow: 0 4px 16px var(--primary-rose-glow);
}

/* ================= Modal: Custom Card Creator ================= */
.modal-backdrop {
  position: fixed;
  inset: 0;
  z-index: 200;
  background: rgba(5, 0, 4, 0.78);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
  transition: all 0.3s ease;
}

.modal-backdrop.hidden {
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
}

.glass-modal-panel {
  background: var(--card-bg);
  border: 1px solid var(--card-border);
  border-radius: 26px;
  max-width: 580px;
  width: 100%;
  max-height: 90vh;
  overflow-y: auto;
  box-shadow: 0 24px 60px rgba(0, 0, 0, 0.7), 0 0 40px rgba(255, 45, 117, 0.2);
  display: flex;
  flex-direction: column;
  animation: modalScaleUp 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}

@keyframes modalScaleUp {
  0% { transform: scale(0.92); opacity: 0; }
  100% { transform: scale(1); opacity: 1; }
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 22px 26px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}

.modal-title-wrap {
  display: flex;
  align-items: center;
  gap: 14px;
}

.modal-icon {
  font-size: 1.8rem;
  color: var(--primary-rose);
}

.modal-header h3 {
  font-family: 'Playfair Display', serif;
  font-size: 1.3rem;
  color: #fff;
}

.modal-header p {
  font-size: 0.8rem;
  color: var(--text-muted);
}

.modal-close-btn {
  background: rgba(255, 255, 255, 0.08);
  border: none;
  width: 36px;
  height: 36px;
  border-radius: 50%;
  color: var(--text-muted);
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
}

.modal-close-btn:hover {
  background: rgba(255, 45, 117, 0.35);
  color: #fff;
}

.modal-body {
  padding: 24px 26px;
  display: flex;
  flex-direction: column;
  gap: 18px;
}

.form-group {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.form-group label {
  font-size: 0.85rem;
  font-weight: 600;
  color: #ffccd8;
  display: flex;
  align-items: center;
  gap: 7px;
}

.form-group input, .form-group textarea {
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.16);
  border-radius: 12px;
  padding: 12px 16px;
  color: #fff;
  font-family: inherit;
  font-size: 0.92rem;
  outline: none;
  transition: all 0.2s;
  resize: vertical;
}

.form-group input:focus, .form-group textarea:focus {
  border-color: var(--primary-rose);
  background: rgba(255, 255, 255, 0.1);
  box-shadow: 0 0 16px var(--primary-rose-glow);
}

/* Quick templates chips */
.quick-templates {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}

.template-chip {
  padding: 6px 12px;
  border-radius: 8px;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.1);
  color: var(--text-muted);
  font-size: 0.76rem;
  cursor: pointer;
  transition: all 0.2s;
}

.template-chip:hover {
  background: rgba(255, 45, 117, 0.25);
  color: #fff;
  border-color: var(--primary-rose);
}

/* Mini Preview Box */
.card-preview-container {
  background: rgba(0, 0, 0, 0.3);
  border: 1px dashed rgba(255, 182, 193, 0.3);
  border-radius: 16px;
  padding: 16px;
  position: relative;
}

.preview-badge {
  position: absolute;
  top: -10px;
  left: 18px;
  background: var(--primary-rose);
  color: #fff;
  font-size: 0.68rem;
  font-weight: 700;
  padding: 2px 10px;
  border-radius: 99px;
  text-transform: uppercase;
}

.mini-preview-card {
  text-align: center;
  padding: 12px;
}

.preview-decor-top {
  font-size: 0.72rem;
  letter-spacing: 2px;
  color: var(--accent-gold);
  margin-bottom: 6px;
}

.preview-to {
  font-family: 'Dancing Script', cursive;
  font-size: 1.15rem;
  color: #fff;
  margin-bottom: 6px;
}

.preview-text {
  font-size: 0.82rem;
  color: #f7d5e2;
  font-style: italic;
  line-height: 1.5;
  margin-bottom: 8px;
}

.preview-from {
  font-family: 'Great Vibes', cursive;
  font-size: 1.15rem;
  color: var(--accent-gold);
  text-align: right;
}

.modal-footer {
  padding: 18px 26px;
  border-top: 1px solid rgba(255, 255, 255, 0.08);
  display: flex;
  justify-content: flex-end;
  gap: 12px;
}

/* ================= Toast Notification ================= */
.toast-popup {
  position: fixed;
  bottom: 30px;
  right: 30px;
  z-index: 9999;
  display: flex;
  align-items: center;
  gap: 12px;
  background: rgba(22, 5, 18, 0.94);
  border: 1px solid var(--accent-gold);
  border-radius: 14px;
  padding: 12px 20px;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5), 0 0 18px var(--accent-gold-glow);
  backdrop-filter: blur(16px);
  color: #fff;
  animation: toastSlideIn 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  transition: all 0.3s;
}

.toast-popup.hidden {
  opacity: 0;
  transform: translateY(20px);
  pointer-events: none;
}

@keyframes toastSlideIn {
  0% { transform: translateY(30px); opacity: 0; }
  100% { transform: translateY(0); opacity: 1; }
}

.toast-icon {
  color: var(--accent-gold);
  font-size: 1.25rem;
}

.toast-message {
  font-size: 0.88rem;
  font-weight: 500;
}

/* ================= Responsive Adaptations ================= */
@media (max-width: 900px) {
  .app-header {
    padding: 0 16px;
    height: 64px;
  }
  .logo-title {
    font-size: 1.05rem;
  }
  .logo-tagline {
    display: none;
  }
  .header-actions .btn-text {
    display: none;
  }
  .scene-controls-hud {
    left: 14px;
    bottom: 80px;
    padding: 8px 10px;
  }
  .luxury-card {
    padding: 30px 22px 24px;
  }
  .card-headline {
    font-size: 1.5rem;
  }
  .gift-callout {
    width: 90%;
    border-radius: 20px;
    bottom: 80px;
    padding: 12px 18px;
  }
}

@media (max-width: 600px) {
  .logo-badge {
    width: 38px;
    height: 38px;
  }
  .scene-controls-hud {
    display: none; /* Auto simplified on very small mobile for pure clean 3D view */
  }
  .card-headline {
    font-size: 1.35rem;
  }
  .card-message {
    font-size: 0.9rem;
    line-height: 1.55;
  }
  .to-name {
    font-size: 1.35rem;
  }
  .sig-name {
    font-size: 1.4rem;
  }
  .card-footer-buttons .pill-btn {
    padding: 8px 14px;
    font-size: 0.78rem;
  }
  .gift-callout {
    flex-direction: column;
    text-align: center;
    border-radius: 20px;
    padding: 14px;
    gap: 10px;
  }
  .callout-badge {
    display: none;
  }
}

/* ===================================================================
   CINEMATIC FILM MODE & MOVIE EXPERIENCE STYLING
   =================================================================== */

.highlight-film-btn {
  background: linear-gradient(135deg, #f59e0b, #ef4444) !important;
  border-color: rgba(254, 240, 138, 0.5) !important;
  color: #fff !important;
  box-shadow: 0 4px 18px rgba(245, 158, 11, 0.45) !important;
}

.highlight-film-btn:hover {
  background: linear-gradient(135deg, #fbbf24, #f43f5e) !important;
  box-shadow: 0 6px 24px rgba(245, 158, 11, 0.7) !important;
  transform: translateY(-2px) scale(1.03);
}

.cinematic-film-overlay {
  position: fixed;
  inset: 0;
  z-index: 150;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  pointer-events: none; /* Keep 3D scene visible and alive */
  transition: opacity 0.8s ease, visibility 0.8s ease;
}

.cinematic-film-overlay.hidden {
  opacity: 0;
  visibility: hidden;
}

.cinematic-film-overlay > * {
  pointer-events: auto;
}

/* Widescreen Movie Letterbox */
.movie-letterbox {
  background: #000;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  box-shadow: 0 0 30px rgba(0, 0, 0, 0.9);
  z-index: 20;
}

.movie-letterbox.top {
  height: 68px;
  border-bottom: 2px solid rgba(246, 211, 101, 0.25);
}

.movie-letterbox.bottom {
  height: 90px;
  border-top: 2px solid rgba(246, 211, 101, 0.25);
  flex-direction: column;
  justify-content: center;
  padding: 0 24px;
}

/* Film Strip & Sprockets */
.film-strip-decor {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  padding: 0 20px;
}

.sprocket-track {
  display: flex;
  gap: 12px;
}

.sprocket {
  width: 14px;
  height: 10px;
  border-radius: 2px;
  background: rgba(255, 255, 255, 0.2);
  border: 1px solid rgba(255, 255, 255, 0.08);
}

.film-movie-title {
  font-family: 'Playfair Display', serif;
  font-size: 0.92rem;
  letter-spacing: 2px;
  color: var(--accent-gold);
  display: flex;
  align-items: center;
  gap: 10px;
  font-weight: 700;
  text-shadow: 0 0 12px rgba(246, 211, 101, 0.5);
}

/* Center Movie Narrative Stage & Subtitles */
.movie-narrative-stage {
  position: absolute;
  bottom: 110px;
  left: 50%;
  transform: translateX(-50%);
  width: 90%;
  max-width: 820px;
  text-align: center;
  z-index: 25;
  background: rgba(14, 2, 10, 0.65);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  border: 1px solid rgba(255, 182, 193, 0.25);
  border-radius: 20px;
  padding: 20px 30px;
  box-shadow: 0 10px 40px rgba(0, 0, 0, 0.6), 0 0 30px rgba(255, 45, 117, 0.2);
}

.movie-chapter-badge {
  display: inline-block;
  padding: 5px 16px;
  background: linear-gradient(90deg, #ff2d75, #f6d365);
  color: #2b0213;
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 1.5px;
  border-radius: 99px;
  margin-bottom: 12px;
  text-transform: uppercase;
}

.movie-subtitles-text {
  font-family: 'Playfair Display', serif;
  font-size: 1.35rem;
  line-height: 1.6;
  font-style: italic;
  color: #fff9fb;
  text-shadow: 0 2px 10px rgba(0, 0, 0, 0.8), 0 0 20px rgba(255, 215, 0, 0.3);
  transition: opacity 0.4s ease;
}

/* Movie Timeline & Controls */
.movie-controls-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 18px;
  width: 100%;
  max-width: 800px;
}

.film-btn {
  background: rgba(255, 255, 255, 0.12);
  border: 1px solid rgba(255, 255, 255, 0.25);
  color: #fff;
  width: 40px;
  height: 40px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  font-size: 1rem;
  transition: all 0.25s;
}

.film-btn:hover {
  background: var(--primary-rose);
  transform: scale(1.1);
  box-shadow: 0 0 15px var(--primary-rose-glow);
}

.film-progress-container {
  flex: 1;
  height: 6px;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 99px;
  overflow: hidden;
}

.film-progress-bar {
  height: 100%;
  width: 0%;
  background: linear-gradient(90deg, #ff2d75, #f6d365);
  border-radius: 99px;
  box-shadow: 0 0 10px #ff2d75;
  transition: width 0.3s ease;
}

.film-time-label {
  font-size: 0.82rem;
  color: var(--text-muted);
  font-family: monospace;
}

.film-exit-button {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 8px 16px;
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(255, 255, 255, 0.2);
  color: #fff;
  font-family: inherit;
  font-size: 0.82rem;
  font-weight: 600;
  border-radius: 99px;
  cursor: pointer;
  transition: all 0.2s;
}

.film-exit-button:hover {
  background: rgba(225, 29, 72, 0.8);
  border-color: #ff2d75;
}

.film-screen-vignette {
  position: absolute;
  inset: 0;
  pointer-events: none;
  background: radial-gradient(ellipse at center, transparent 40%, rgba(0, 0, 0, 0.45) 100%);
  z-index: 10;
}

/* ===================================================================
   CUTE ANIMATED MASCOT COMPANION (BUNNY / BEAR)
   =================================================================== */

.mascot-companion {
  position: fixed;
  right: 28px;
  bottom: 84px;
  z-index: 60;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.mascot-speech-bubble {
  position: relative;
  background: rgba(28, 7, 22, 0.88);
  border: 1px solid rgba(255, 182, 193, 0.4);
  border-radius: 16px;
  padding: 9px 15px;
  max-width: 220px;
  font-size: 0.8rem;
  color: #fff;
  text-align: center;
  margin-bottom: 12px;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4), 0 0 15px rgba(255, 45, 117, 0.2);
  backdrop-filter: blur(12px);
  animation: bubbleFloat 2.6s ease-in-out infinite alternate;
}

.bubble-arrow {
  position: absolute;
  bottom: -6px;
  left: 50%;
  transform: translateX(-50%) rotate(45deg);
  width: 12px;
  height: 12px;
  background: rgba(28, 7, 22, 0.88);
  border-right: 1px solid rgba(255, 182, 193, 0.4);
  border-bottom: 1px solid rgba(255, 182, 193, 0.4);
}

@keyframes bubbleFloat {
  0% { transform: translateY(0); }
  100% { transform: translateY(-5px); }
}

/* Mascot Vector Body */
.mascot-interactive-body {
  position: relative;
  width: 76px;
  height: 76px;
  cursor: pointer;
  filter: drop-shadow(0 6px 16px rgba(0, 0, 0, 0.4));
  transition: transform 0.2s;
}

.mascot-interactive-body:hover {
  transform: scale(1.08);
}

.mascot-jump {
  animation: mascotJumpAnim 0.6s cubic-bezier(0.16, 1, 0.3, 1) !important;
}

@keyframes mascotJumpAnim {
  0% { transform: scale(1) translateY(0); }
  40% { transform: scale(1.2) translateY(-24px) rotate(-6deg); }
  70% { transform: scale(0.95) translateY(4px); }
  100% { transform: scale(1) translateY(0); }
}

/* Ears */
.mascot-ears {
  position: absolute;
  top: -12px;
  left: 0;
  right: 0;
  display: flex;
  justify-content: space-between;
  padding: 0 10px;
  z-index: 1;
}

.ear {
  width: 18px;
  height: 30px;
  background: #fff;
  border-radius: 50% 50% 40% 40%;
  position: relative;
  border: 2px solid #ffb8d2;
}

.ear-left {
  transform: rotate(-12deg);
  animation: earWiggleLeft 3.5s ease-in-out infinite;
}

.ear-right {
  transform: rotate(12deg);
  animation: earWiggleRight 3.5s ease-in-out infinite 0.3s;
}

.ear-inner {
  position: absolute;
  inset: 4px 3px;
  background: #ffb8d2;
  border-radius: 50%;
}

@keyframes earWiggleLeft {
  0%, 90%, 100% { transform: rotate(-12deg); }
  93% { transform: rotate(-24deg); }
  96% { transform: rotate(-8deg); }
}

@keyframes earWiggleRight {
  0%, 90%, 100% { transform: rotate(12deg); }
  93% { transform: rotate(24deg); }
  96% { transform: rotate(8deg); }
}

/* Head */
.mascot-head {
  position: relative;
  width: 76px;
  height: 64px;
  background: #ffffff;
  border-radius: 50% 50% 45% 45%;
  border: 2px solid #ffccd8;
  z-index: 2;
  overflow: hidden;
  box-shadow: inset 0 -4px 8px rgba(255, 182, 193, 0.4);
}

.mascot-eyes {
  position: absolute;
  top: 24px;
  left: 0;
  right: 0;
  display: flex;
  justify-content: space-around;
  padding: 0 14px;
}

.eye {
  width: 9px;
  height: 10px;
  background: #33101b;
  border-radius: 50%;
  position: relative;
  animation: eyeBlink 4s infinite;
}

.eye-pupil {
  position: absolute;
  top: 1px;
  right: 2px;
  width: 3px;
  height: 3px;
  background: #fff;
  border-radius: 50%;
}

@keyframes eyeBlink {
  0%, 95%, 100% { transform: scaleY(1); }
  97% { transform: scaleY(0.1); }
}

.mascot-blush {
  position: absolute;
  top: 32px;
  width: 14px;
  height: 8px;
  background: rgba(255, 105, 140, 0.55);
  border-radius: 50%;
}

.blush-left { left: 8px; }
.blush-right { right: 8px; }

.mascot-nose {
  position: absolute;
  top: 28px;
  left: 50%;
  transform: translateX(-50%);
  width: 7px;
  height: 5px;
  background: #ff5e88;
  border-radius: 50%;
}

.mascot-mouth {
  position: absolute;
  top: 34px;
  left: 50%;
  transform: translateX(-50%);
  width: 10px;
  height: 6px;
  border-bottom: 2px solid #5a1228;
  border-radius: 0 0 8px 8px;
}

/* Paws & Bouquet */
.mascot-paws {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 6px;
  z-index: 5;
}

.paw {
  width: 16px;
  height: 14px;
  background: #fff;
  border: 1px solid #ffccd8;
  border-radius: 50%;
}

.paw-wave {
  animation: pawWaving 1.8s ease-in-out infinite alternate;
  transform-origin: bottom right;
}

@keyframes pawWaving {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(-25deg) translateY(-4px); }
}

.mascot-flower-bouquet {
  display: flex;
  align-items: center;
  position: relative;
  font-size: 1.4rem;
  animation: bouquetSway 2.4s ease-in-out infinite alternate;
}

.bouquet-sparkle {
  position: absolute;
  top: -8px;
  right: -6px;
  font-size: 0.85rem;
  animation: sparkleTwinkle 1.5s infinite alternate;
}

@keyframes bouquetSway {
  0% { transform: rotate(-6deg); }
  100% { transform: rotate(6deg); }
}

@keyframes sparkleTwinkle {
  0% { opacity: 0.3; transform: scale(0.8); }
  100% { opacity: 1; transform: scale(1.2); }
}

/* ===================================================================
   FLOATING CUTE ANIMATED STICKERS LAYER
   =================================================================== */

.cute-stickers-layer {
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: 45;
}

.cute-sticker {
  position: absolute;
  pointer-events: auto;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 10px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(255, 255, 255, 0.15);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
  transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), background 0.25s;
}

.cute-sticker:hover {
  transform: scale(1.3) rotate(10deg);
  background: rgba(255, 45, 117, 0.25);
  border-color: rgba(255, 255, 255, 0.4);
}

.sticker-pop {
  animation: stickerPopAnim 0.5s ease-out;
}

@keyframes stickerPopAnim {
  0% { transform: scale(1); }
  50% { transform: scale(1.5) rotate(-15deg); }
  100% { transform: scale(1); }
}

.sticker-emoji {
  font-size: 1.8rem;
  filter: drop-shadow(0 2px 8px rgba(0, 0, 0, 0.3));
}

.sticker-sparkle {
  position: absolute;
  top: -4px;
  right: -4px;
  font-size: 0.9rem;
}

/* Sticker Positions & Gentle Floating Animations */
.sticker-1 {
  top: 18%;
  left: 6%;
  animation: stickerFloatA 5.5s ease-in-out infinite alternate;
}

.sticker-2 {
  top: 28%;
  right: 7%;
  animation: stickerFloatB 6.2s ease-in-out infinite alternate;
}

.sticker-3 {
  bottom: 30%;
  left: 8%;
  animation: stickerFloatB 5.8s ease-in-out infinite alternate 0.5s;
}

.sticker-4 {
  top: 15%;
  right: 18%;
  animation: stickerFloatA 6.8s ease-in-out infinite alternate 1s;
}

.sticker-5 {
  bottom: 22%;
  right: 14%;
  animation: stickerFloatA 5.2s ease-in-out infinite alternate 0.2s;
}

.sticker-6 {
  top: 42%;
  left: 4%;
  animation: stickerFloatB 6.0s ease-in-out infinite alternate 0.8s;
}

@keyframes stickerFloatA {
  0% { transform: translateY(0) rotate(0deg); }
  50% { transform: translateY(-16px) rotate(6deg); }
  100% { transform: translateY(8px) rotate(-6deg); }
}

@keyframes stickerFloatB {
  0% { transform: translateY(0) rotate(0deg); }
  50% { transform: translateY(14px) rotate(-8deg); }
  100% { transform: translateY(-12px) rotate(8deg); }
}

/* Heart Burst On Mascot / Sticker Click */
.burst-heart-particle {
  position: fixed;
  font-size: 1.4rem;
  pointer-events: none;
  z-index: 99999;
  animation: burstHeartRise 1.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

@keyframes burstHeartRise {
  0% { opacity: 1; transform: translate(0, 0) scale(0.6); }
  50% { opacity: 0.9; transform: translate(calc((var(--rnd, 0.5) - 0.5) * 60px), -60px) scale(1.3); }
  100% { opacity: 0; transform: translate(calc((var(--rnd, 0.5) - 0.5) * 80px), -120px) scale(0.8); }
}

/* ===================================================================
   TYPEWRITER PROGRESSIVE REVEAL STYLING
   =================================================================== */

.typewriter-text {
  display: inline;
  color: var(--text-main);
  text-shadow: 0 0 12px rgba(255, 255, 255, 0.25);
  font-family: inherit;
  line-height: 1.7;
}

.typewriter-cursor {
  display: inline-block;
  color: var(--accent-gold);
  font-weight: 700;
  margin-left: 2px;
  animation: cursorBlink 0.75s step-start infinite;
  text-shadow: 0 0 14px var(--accent-gold);
}

@keyframes cursorBlink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0; }
}

.typewriter-hint {
  text-align: center;
  font-size: 0.72rem;
  color: var(--text-muted);
  opacity: 0.65;
  margin-top: 10px;
  cursor: pointer;
  transition: all 0.25s;
  letter-spacing: 0.5px;
}

.typewriter-hint:hover {
  opacity: 1;
  color: var(--accent-gold);
  transform: translateY(-1px);
}

/* ===================================================================
   ANIMATED CARTOON CHARACTERS WORLD
   =================================================================== */

.animated-characters-world {
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: 55;
}

/* 1. FLYING CHIBI FAIRY GIRL WITH BALLOONS */
.flying-fairy-character {
  position: absolute;
  top: 12%;
  left: 0;
  width: 80px;
  height: 120px;
  pointer-events: auto;
  cursor: pointer;
  animation: fairyFlightPath 26s ease-in-out infinite alternate;
  filter: drop-shadow(0 8px 18px rgba(0, 0, 0, 0.35));
  transition: transform 0.3s;
}

.flying-fairy-character:hover {
  transform: scale(1.15);
}

.fairy-spin {
  animation: fairySpinJoy 0.8s cubic-bezier(0.16, 1, 0.3, 1) !important;
}

@keyframes fairySpinJoy {
  0% { transform: rotate(0deg) scale(1); }
  50% { transform: rotate(360deg) scale(1.3); }
  100% { transform: rotate(720deg) scale(1); }
}

@keyframes fairyFlightPath {
  0% { transform: translate(3vw, 0) rotate(2deg); }
  25% { transform: translate(25vw, -18px) rotate(-3deg); }
  50% { transform: translate(50vw, 12px) rotate(4deg); }
  75% { transform: translate(75vw, -20px) rotate(-2deg); }
  100% { transform: translate(88vw, 0) rotate(3deg); }
}

/* Fairy Balloons */
.fairy-balloons {
  position: absolute;
  top: -24px;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  gap: 4px;
}

.heart-balloon {
  width: 22px;
  height: 20px;
  position: relative;
  border-radius: 50% 50% 0 0;
  transform: rotate(-45deg);
  box-shadow: inset 0 -2px 6px rgba(0, 0, 0, 0.2), 0 4px 10px rgba(255, 45, 117, 0.3);
  animation: balloonSway 3s ease-in-out infinite alternate;
}

.heart-balloon::before {
  content: "";
  position: absolute;
  width: 22px;
  height: 20px;
  border-radius: 50% 50% 0 0;
  transform: rotate(90deg);
  background: inherit;
  top: 0;
  left: 0;
}

.balloon-pink { background: linear-gradient(135deg, #ff758c, #ff7eb3); }
.balloon-gold { background: linear-gradient(135deg, #ffd700, #ffb700); animation-delay: 0.3s; }
.balloon-rose { background: linear-gradient(135deg, #ff2d75, #fb7185); animation-delay: 0.6s; }

@keyframes balloonSway {
  0% { transform: rotate(-45deg) translateY(0); }
  100% { transform: rotate(-45deg) translateY(-6px); }
}

/* Fairy Wings */
.fairy-wings {
  position: absolute;
  top: 36px;
  left: 50%;
  transform: translateX(-50%);
  width: 60px;
  display: flex;
  justify-content: space-between;
}

.wing {
  width: 26px;
  height: 38px;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.85) 0%, rgba(255, 182, 193, 0.4) 100%);
  border: 1px solid rgba(255, 255, 255, 0.8);
  border-radius: 50% 50% 20% 80%;
  box-shadow: 0 0 10px rgba(255, 255, 255, 0.6);
}

.wing-l {
  transform-origin: right center;
  animation: wingFlapLeft 0.35s ease-in-out infinite alternate;
}

.wing-r {
  transform-origin: left center;
  transform: scaleX(-1);
  animation: wingFlapRight 0.35s ease-in-out infinite alternate;
}

@keyframes wingFlapLeft {
  0% { transform: rotate(15deg) scaleY(1); }
  100% { transform: rotate(-25deg) scaleY(0.7); }
}

@keyframes wingFlapRight {
  0% { transform: scaleX(-1) rotate(15deg) scaleY(1); }
  100% { transform: scaleX(-1) rotate(-25deg) scaleY(0.7); }
}

/* Fairy Body & Face */
.fairy-body-wrap {
  position: relative;
  width: 48px;
  margin: 0 auto;
  text-align: center;
}

.fairy-hair {
  position: absolute;
  top: 18px;
  left: 50%;
  transform: translateX(-50%);
  width: 38px;
  height: 42px;
  background: #ffb8d2;
  border-radius: 50% 50% 40% 40%;
  border: 2px solid #ff758c;
  z-index: 2;
}

.fairy-face {
  position: relative;
  top: 24px;
  width: 32px;
  height: 30px;
  margin: 0 auto;
  background: #fff5eb;
  border-radius: 50%;
  z-index: 3;
  border: 1px solid #ffd0c0;
}

.fairy-eyes {
  display: flex;
  justify-content: space-around;
  padding: 8px 5px 0;
}

.f-eye {
  width: 5px;
  height: 6px;
  background: #4a1525;
  border-radius: 50%;
  animation: eyeBlink 3.8s infinite;
}

.fairy-blush {
  position: absolute;
  top: 15px;
  left: 3px;
  right: 3px;
  height: 4px;
  background: rgba(255, 90, 120, 0.4);
  border-radius: 4px;
}

.fairy-smile {
  position: absolute;
  bottom: 4px;
  left: 50%;
  transform: translateX(-50%);
  width: 8px;
  height: 4px;
  border-bottom: 2px solid #d946ef;
  border-radius: 0 0 6px 6px;
}

.fairy-dress {
  position: relative;
  top: 20px;
  margin: 0 auto;
  width: 26px;
  height: 24px;
  background: linear-gradient(135deg, #ff2d75, #ff758c);
  border-radius: 30% 30% 50% 50%;
  z-index: 2;
  box-shadow: 0 2px 8px rgba(255, 45, 117, 0.4);
}

.fairy-basket {
  position: absolute;
  right: -8px;
  bottom: -2px;
  font-size: 1.1rem;
  z-index: 5;
  animation: basketSway 2s ease-in-out infinite alternate;
}

@keyframes basketSway {
  0% { transform: rotate(-8deg); }
  100% { transform: rotate(8deg); }
}

.fairy-sparkle-trail {
  position: absolute;
  bottom: 0;
  left: 50%;
  font-size: 1rem;
  color: var(--accent-gold);
  animation: sparkleTwinkle 1.2s infinite alternate;
}

/* 2. DANCING TEDDY BEAR ON CLOUD (BOTTOM LEFT) */
.dancing-bear-character {
  position: fixed;
  bottom: 86px;
  left: 30px;
  width: 84px;
  height: 100px;
  pointer-events: auto;
  cursor: pointer;
  z-index: 60;
  filter: drop-shadow(0 8px 20px rgba(0, 0, 0, 0.4));
  transition: transform 0.25s;
}

.dancing-bear-character:hover {
  transform: scale(1.1);
}

.bear-bounce {
  animation: bearJoyBounce 0.6s cubic-bezier(0.16, 1, 0.3, 1) !important;
}

@keyframes bearJoyBounce {
  0% { transform: translateY(0) scale(1); }
  50% { transform: translateY(-20px) scale(1.15) rotate(5deg); }
  100% { transform: translateY(0) scale(1); }
}

/* Soft Cloud Podium */
.cloud-podium {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 22px;
  display: flex;
  justify-content: center;
  align-items: center;
}

.cloud-bubble {
  background: rgba(255, 255, 255, 0.85);
  border-radius: 50%;
  box-shadow: 0 0 14px rgba(255, 182, 193, 0.6);
}

.cloud-bubble.c1 { width: 34px; height: 20px; }
.cloud-bubble.c2 { width: 44px; height: 24px; margin: 0 -8px; z-index: 1; }
.cloud-bubble.c3 { width: 34px; height: 20px; }

/* Bear Figure */
.bear-figure {
  position: relative;
  width: 60px;
  margin: 0 auto;
  animation: bearSwayDance 2.4s ease-in-out infinite alternate;
  transform-origin: bottom center;
}

@keyframes bearSwayDance {
  0% { transform: rotate(-5deg) translateY(0); }
  50% { transform: rotate(0deg) translateY(-5px); }
  100% { transform: rotate(5deg) translateY(0); }
}

.bear-ears {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  display: flex;
  justify-content: space-between;
  padding: 0 4px;
}

.b-ear {
  width: 16px;
  height: 16px;
  background: #c88753;
  border-radius: 50%;
  position: relative;
  border: 1px solid #9c5c2a;
}

.b-ear-in {
  position: absolute;
  inset: 3px;
  background: #fbd6b4;
  border-radius: 50%;
}

.bear-head {
  position: relative;
  top: 8px;
  width: 52px;
  height: 44px;
  background: #c88753;
  border-radius: 50% 50% 45% 45%;
  margin: 0 auto;
  border: 1px solid #9c5c2a;
}

.bear-eyes {
  display: flex;
  justify-content: space-around;
  padding: 14px 10px 0;
}

.b-eye {
  width: 6px;
  height: 7px;
  background: #2b1103;
  border-radius: 50%;
  animation: eyeBlink 3.2s infinite;
}

.bear-muzzle {
  position: absolute;
  bottom: 5px;
  left: 50%;
  transform: translateX(-50%);
  width: 22px;
  height: 16px;
  background: #fbd6b4;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.b-nose {
  width: 7px;
  height: 5px;
  background: #4a2108;
  border-radius: 50% 50% 60% 60%;
}

.b-mouth {
  width: 8px;
  height: 4px;
  border-bottom: 2px solid #4a2108;
  border-radius: 0 0 4px 4px;
}

.bear-cheeks {
  position: absolute;
  top: 20px;
  left: 4px;
  right: 4px;
  height: 6px;
  background: rgba(255, 90, 120, 0.35);
  border-radius: 4px;
}

.bear-body {
  position: relative;
  top: 4px;
  width: 44px;
  height: 34px;
  background: #c88753;
  border-radius: 40% 40% 50% 50%;
  margin: 0 auto;
  border: 1px solid #9c5c2a;
}

.bear-belly {
  position: absolute;
  top: 6px;
  left: 50%;
  transform: translateX(-50%);
  width: 24px;
  height: 22px;
  background: #fbd6b4;
  border-radius: 50%;
}

.bear-arm {
  position: absolute;
  top: 4px;
  width: 14px;
  height: 18px;
  background: #c88753;
  border-radius: 50%;
  border: 1px solid #9c5c2a;
}

.arm-l { left: -6px; transform: rotate(15deg); }
.arm-r { right: -6px; transform: rotate(-25deg); }

.wand-flower {
  position: absolute;
  top: -12px;
  right: -8px;
  font-size: 1.25rem;
  animation: wandSparkle 1.8s ease-in-out infinite alternate;
}

@keyframes wandSparkle {
  0% { transform: scale(1) rotate(0deg); }
  100% { transform: scale(1.2) rotate(15deg); }
}

.bear-feet {
  position: relative;
  top: 2px;
  display: flex;
  justify-content: space-around;
  padding: 0 6px;
}

.b-foot {
  width: 16px;
  height: 12px;
  background: #b57440;
  border-radius: 50%;
}

/* 3. PLAYFUL CUTE KITTY CAT (RIGHT SIDE) */
.playful-cat-character {
  position: fixed;
  bottom: 24px;
  right: 250px;
  width: 64px;
  height: 58px;
  pointer-events: auto;
  cursor: pointer;
  z-index: 60;
  transition: transform 0.2s;
  filter: drop-shadow(0 6px 16px rgba(0, 0, 0, 0.35));
}

.playful-cat-character:hover {
  transform: scale(1.15);
}

.cat-meow {
  animation: catMeowAnim 0.6s ease-in-out !important;
}

@keyframes catMeowAnim {
  0% { transform: scale(1); }
  50% { transform: scale(1.2) translateY(-14px) rotate(-8deg); }
  100% { transform: scale(1); }
}

.cat-head {
  position: relative;
  width: 48px;
  height: 40px;
  background: #ffffff;
  border-radius: 50% 50% 45% 45%;
  border: 1.5px solid #ffccd8;
  margin: 0 auto;
}

.cat-ears {
  position: absolute;
  top: -8px;
  left: 0;
  right: 0;
  display: flex;
  justify-content: space-between;
  padding: 0 4px;
}

.c-ear {
  width: 14px;
  height: 14px;
  background: #ffffff;
  border: 1.5px solid #ffccd8;
  transform: rotate(45deg);
  border-radius: 4px;
}

.c-ear-l { animation: earTwitchLeft 3s infinite; }
.c-ear-r { animation: earTwitchRight 3.5s infinite; }

@keyframes earTwitchLeft {
  0%, 90%, 100% { transform: rotate(45deg); }
  94% { transform: rotate(30deg); }
}

@keyframes earTwitchRight {
  0%, 90%, 100% { transform: rotate(45deg); }
  94% { transform: rotate(60deg); }
}

.cat-eyes {
  display: flex;
  justify-content: space-around;
  padding: 12px 6px 0;
}

.c-eye {
  width: 6px;
  height: 7px;
  background: #361421;
  border-radius: 50%;
  animation: eyeBlink 3.6s infinite;
}

.cat-nose {
  position: absolute;
  top: 20px;
  left: 50%;
  transform: translateX(-50%);
  width: 5px;
  height: 4px;
  background: #ff758c;
  border-radius: 50%;
}

.cat-whiskers {
  position: absolute;
  top: 18px;
  width: 14px;
  height: 8px;
}

.w-l { left: -6px; }
.w-r { right: -6px; }

.cat-whiskers span {
  display: block;
  width: 12px;
  height: 1px;
  background: #ffb8d2;
  margin: 2px 0;
}

/* Cat Tail */
.cat-tail-wrap {
  position: absolute;
  bottom: 4px;
  left: -12px;
  width: 20px;
  height: 30px;
}

.cat-tail {
  width: 8px;
  height: 28px;
  background: #fff;
  border: 1.5px solid #ffccd8;
  border-radius: 99px;
  transform-origin: bottom center;
  animation: catTailWag 2s ease-in-out infinite alternate;
}

@keyframes catTailWag {
  0% { transform: rotate(-15deg); }
  100% { transform: rotate(35deg); }
}

.cat-rose-sniff {
  position: absolute;
  top: -10px;
  right: -10px;
  font-size: 1.3rem;
  animation: roseSniffFloat 2.2s ease-in-out infinite alternate;
}

@keyframes roseSniffFloat {
  0% { transform: translateY(0) rotate(0deg); }
  100% { transform: translateY(-4px) rotate(10deg); }
}

/* Small Screen Layout Adjustments for Animated Characters */
@media (max-width: 900px) {
  .flying-fairy-character {
    top: 8%;
    transform: scale(0.85);
  }
  .dancing-bear-character {
    bottom: 74px;
    left: 10px;
    transform: scale(0.85);
  }
  .playful-cat-character {
    display: none; /* Hide cat on smaller screens to avoid overlapping controls */
  }
}
